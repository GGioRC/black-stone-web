  "special": {
    "Greymist": {
      "es": "La niebla bloquea la visibilidad incluso con visiones especiales, amortigua el sonido y dificulta orientarse o detectar amenazas. La Máscara de Oktar permite ignorar su impedimento visual."
    },
    "Sparkmist": {
      "es": "Tras tres rondas, las chispas afectan a los seres vivos. Conserva las dificultades de visibilidad de Greymist. Consulta la variante de energía."
    },
    "Mistwalls": {
      "es": "La niebla forma un muro sólido; su clave elemental puede dispersarlo durante una hora. Un resultado 6 requiere una decisión del Amo."
    },
    "Misttides": {
      "es": "La niebla se espesa o forma corrientes que desplazan a los viajeros; el Amo resuelve el recorrido y las salvaciones."
    }
  }
}
